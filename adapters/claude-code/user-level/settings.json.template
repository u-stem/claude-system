{
  "//": "Claude Code user-level settings template. tools/sync-settings.sh が本 template ⊕ マシン固有 overrides をレンダリングして ~/.claude/settings.json に配置する(symlink ではなく cp。マシン固有値の差し込みのため / ADR 0017)。'//' で始まるキーは Claude Code 側で無視されるため JSON コメント代替として使用",

  "// env": "サブプロセスへ機密 env を漏らさない、autocompact 閾値、1h prompt cache 等。EXPERIMENTAL_AGENT_TEAMS は Opus 4.7 期に厳格化(3 PBI 以上 + 完全独立ファイルのみ適用)し、Fable 5 期も有効維持(ADR 0010 / 0016)。AUTOCOMPACT_PCT_OVERRIDE は 85→70 に引き下げ(2026-05): 巨大コンテキスト(1M 窓の高%保持)が 'tool call could not be parsed' を誘発しやすいため早めに圧縮する。安易に戻さないこと",
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },

  "respectGitignore": true,
  "language": "japanese",
  "// model": "Opus 5 へ乗り換え(ADR 0022): 日常のコーディング/エージェント用途で Fable 5 同等以上・半額。[1m] を明示指定して 1M 窓を確定。長時間自律タスク・難所推論で品質不足を感じたら Fable 5 へ戻す(/model fable で一時切替可)。fallbackModel は過負荷・不達時の縮退先(v2.1.166 追加、配列・最大 3 件)で、1 世代前の既知良品として Opus 4.8 を維持(ADR 0016 の『安全クラシファイア整合』根拠は別系統機構の誤帰属だったため撤回、ADR 0022)。effortLevel は最難作業(オーケストレーション + 難所推論)への校正として xhigh(ADR 0013 / 0022 で machine-overrides の medium 上書きを解消)",
  "model": "claude-opus-5[1m]",
  "fallbackModel": ["claude-opus-4-8"],
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "sandbox": {
    "failIfUnavailable": true
  },

  "// attribution": "Public メタリポの commit/PR に claude.ai セッション URL(harness 自動 attribution)を混入させない(ADR 0002 / 0018)。安定 settings スキーマに sessionUrl キーは存在せず(additionalProperties: false)、commit/pr を空文字にすると当該 attribution ブロックごと抑止される。Co-Authored-By トレーラと 'Generated with Claude Code' は user-level/CLAUDE.md の指示でモデルが別途付与するため失われない",
  "attribution": {
    "commit": "",
    "pr": ""
  },

  "// permissions": "deny は物理ブロック(LLM の自制に頼らない)。allow は良性で頻出するコマンドを列挙して permission prompt を抑制する。両者の整合は Phase 7b で再点検する",
  "// permissions.deny.protected_paths": "旧 claude-settings はアーカイブで読み取り専用のため write を物理ブロック",
  "// permissions.deny.backup_files": "*.backup-* は人間が手作業バックアップした原本。LLM が上書きしないよう物理ブロック",
  "// permissions.deny.destructive_filesystem": "~/.claude/ や claude-system 全体の rm を物理ブロック。シンボリックリンク構成を保護する。-rf 以外の派生(-r 単独 / sudo / find -delete)も列挙",
  "// permissions.deny.destructive_git": "強制 push と --no-verify は禁止。--no-verify は Phase 7b の PreToolUse hook(jq インライン)でも検出予定の二重防御。push 側の --no-verify を明示 deny するのは tools/githooks/pre-push を素通りさせないため(ADR 0024 §2a)",
  "// permissions.deny.secrets": "機密ファイル系の Read/Edit を全面ブロック。Phase 7b で .gitleaks.toml と整合させる。相対パス glob が中心のため絶対パス・~ 展開後のアクセスは hooks 側(pre-edit-protect.sh / pre-bash-guard.sh)で補完する",
  "// permissions.deny.edit_governs_all_edits": "v2.1.210 以降、file permission チェックは Edit(path) / Read(path) ルールのみ照合し、Edit ルールが全編集ツール(Write / NotebookEdit 含む)を統治する。旧 Write(path) deny 7 件は照合対象外の死文となったため削除(ADR 0021)。./.env への Write が Edit(./.env) deny で拒否されることは 2.1.217 で実測確認済み",
  "// permissions.deny.global_secrets": "ホームディレクトリ直下の標準的機密保管箇所を deny。.ssh / .aws / .gnupg / .config の認証系は内容にかかわらず Read を物理ブロック",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Edit(~/ws/claude-settings/**)",
      "Edit(**/*.backup-*)",
      "Bash(rm -rf ~/.claude*)",
      "Bash(rm -r ~/.claude*)",
      "Bash(rm -rf ~/ws/claude-system)",
      "Bash(rm -r ~/ws/claude-system)",
      "Bash(rm -rf ~/ws/claude-system/*)",
      "Bash(sudo rm *)",
      "Bash(find ~/.claude*)",
      "Bash(find ~/ws/claude-system*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git push*--no-verify*)",
      "Bash(cd)",
      "Bash(cd *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/credentials*)",
      "Read(./**/*secret*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.docker/config.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)"
    ],
    "// permissions.allow.package_managers": "bun > pnpm > npm の優先順は user-level/CLAUDE.md 記載と整合。uv は Python 用",
    "// permissions.allow.compilers": "cargo / go / python3 / node / deno",
    "// permissions.allow.git": "git は deny 側で強制 push と --no-verify をブロック済みのため allow 側はワイルドカードで良い",
    "// permissions.allow.shell_basics": "読み取り系・移動系・展開系。意図しない副作用は deny 側で個別ブロック",
    "// permissions.allow.file_ops": "削除系(rm 等)は意図的に allow に入れない。都度 ask で十分",
    "// permissions.allow.network": "取得系のみ。送信系の curl -X POST 等は都度 ask",
    "// permissions.allow.docker": "観察系のみ allow。run / build / push 系は ask",
    "// permissions.allow.audit_tools": "security-auditor subagent / dependency-review skill / supply-chain-hygiene practice で利用する読み取り系監査コマンド。bun audit / npm audit / uv pip audit は package manager のワイルドカードで covered、gitleaks のみ独立 allow が必要",
    "allow": [
      "Bash(bun *)",
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npm install)",
      "Bash(npm add *)",
      "Bash(npm uninstall *)",
      "Bash(npm ls *)",
      "Bash(npm info *)",
      "Bash(npm outdated *)",
      "Bash(npm audit *)",
      "Bash(uv *)",
      "Bash(cargo *)",
      "Bash(rustfmt *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(deno *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(bash *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(tree *)",
      "Bash(tree)",
      "Bash(date *)",
      "Bash(date)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(diff *)",
      "Bash(comm *)",
      "Bash(uname *)",
      "Bash(printenv *)",
      "Bash(id)",
      "Bash(whoami)",
      "Bash(make *)",
      "Bash(make)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(gzip *)",
      "Bash(gunzip *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker ps *)",
      "Bash(docker ps)",
      "Bash(docker images *)",
      "Bash(docker images)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker compose *)",
      "Bash(claude *)",
