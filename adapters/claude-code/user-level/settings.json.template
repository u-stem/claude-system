      "Bash(gitleaks version)",
      "Bash(gitleaks version *)",
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch"
    ]
  },

  "// hooks": "Phase 7b で結線。本物の実体は adapters/claude-code/user-level/hooks/*.sh で、~/.claude/hooks/ に symlink されている。緊急停止は tools/disable-guardrails.sh を使う(--dry-run で事前確認可)",
  "// hooks.SessionStart": "繰り返し失敗パターンを通知して self-improving loop を促す",
  "// hooks.PreToolUse.Bash": "破壊的コマンド阻止 + 若いパッケージ阻止(supply-chain)+ 大量出力の末尾キャップ(token 経済、ADR 0012)。各 hook は対象外コマンドで早期 exit する。output-cap は test/build/lint の単純コマンドのみ updatedInput で stdout を tail。CLAUDE_BASH_OUTPUT_CAP=0 で無効化",
  "// hooks.PreToolUse.Edit_Write": "claude-settings/ や *.backup-* への書き込み阻止 + principles/practices への禁止語混入阻止",
  "// hooks.PostToolUse.Edit_Write": "validate(SKILL.md frontmatter / 禁止語) + project dispatcher(.claude/hooks/post-edit.sh)",
  "// hooks.PostToolUseFailure.Bash": "Bash 失敗を category 判定して failure-log.jsonl に追記(self-referential feedback loop)。PostToolUse ではなく PostToolUseFailure にバインド: Claude Code は失敗した Bash コマンドで PostToolUse を発火しないため(v2.1.206 で実測確認)",
  "// hooks.Stop": "stop diagnostic(timeout 付き doctor.sh)+ project dispatcher(.claude/hooks/post-stop.sh)",
  "// hooks.SubagentStop": "基本ログ + ADR 0001/0002 サニタイゼーション + tools 越権検知(log-only、Phase 9 で escalation 再評価)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/check-failure-patterns.sh"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/pre-bash-guard.sh"},
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/check-package-age.sh"},
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/pre-bash-output-cap.sh"}
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/pre-edit-protect.sh"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/post-edit-validate.sh"},
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/post-edit-dispatcher.sh"}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/log-bash-failure.sh"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/stop-session-doctor.sh"},
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/post-stop-dispatcher.sh"}
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/notify-stop-failure.sh"}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/subagent-stop-record.sh"},
          {"type": "command", "command": "$HOME/ws/claude-system/adapters/claude-code/user-level/hooks/subagent-stop-audit.sh"}
        ]
      }
    ],
    "PreCompact": [],
    "SessionEnd": []
  },

  "// extraKnownMarketplaces": "enabledPlugins の解決に必要な marketplace 宣言。`claude plugin marketplace add` は本キーを配置済み settings.json に直接書くが、settings.json は template ⊕ overrides の決定論的レンダリング成果物(ADR 0017)であるため、template に持たない限り次回 sync で消える。ADR 0023 で実測確認のうえ template 管理に移した(= 別マシンでも再現される)",
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },

  "// enabledPlugins": "superpowers / elements-of-style / episodic-memory は新システムでも継続採用。Memory MCP は不採用(ADR 0003 で確定済み)。宣言だけでは導入されず `claude plugin install` が別途必要(ADR 0003 の『enabledPlugins で完結』は誤り。ADR 0023 で是正し tools/setup-plugins.sh + doctor.sh 検査を追加)",
  "enabledPlugins": {
    "elements-of-style@superpowers-marketplace": true,
    "episodic-memory@superpowers-marketplace": true,
    "superpowers@superpowers-marketplace": true
  },

  "// auditedPluginVersions.why": "ADR 0023 §3 で持ち込み能力(hooks / MCP / subagent / skill)を棚卸しした版。`claude plugin install` は版指定を取らず常に最新が入るため、実インストール版がこことずれたら『未監査の payload が動いている』ことを意味する。doctor.sh がファイル読みのみで照合し WARN する。棚卸しをやり直したらこの値を更新する。キーが '//' 始まりなのは Claude Code 側に未知キーとして渡さないため(本ファイル冒頭の規約)",
  "// auditedPluginVersions": {
    "elements-of-style@superpowers-marketplace": "1.0.0",
    "episodic-memory@superpowers-marketplace": "1.4.2",
    "superpowers@superpowers-marketplace": "6.2.0"
  },

  "// mcpServers": "常時ロードする非 secret MCP のみ inline 宣言する(決定論・自動同期 / ADR 0017)。opt-in の非 secret(sequential-thinking / chrome-devtools)と secret 必須(github)は mcp/servers.template.json + setup-mcp.sh 経由。playwright の二重登録を解消し runner を bunx に統一(bun 優先 / ADR 0018 の review follow-up)。pin は 2 系統で同一に保つ",
  "mcpServers": {
    "playwright": {
      "command": "bunx",
      "args": ["-y", "@playwright/mcp@0.0.79"]
    }
  }
}
